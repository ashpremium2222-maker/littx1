{
  "version": 2,
  "buildCommand": "cd staging/combined-app && npm install && npm run build && mv dist/index.html dist/app.html && cp ../../index.html dist/index.html && cp ../../logo.png dist/logo.png",
  "outputDirectory": "staging/combined-app/dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "organiser.littx.in"
        }
      ],
      "destination": "/organizer",
      "permanent": false,
      "preserveQueryParams": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/organizer",
      "destination": "/app.html"
    },
    {
      "source": "/organizer/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/bookings",
      "destination": "/app.html"
    },
    {
      "source": "/accept-invitation",
      "destination": "/app.html"
    },
    {
      "source": "/bookings/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/solverbydevashtu",
      "destination": "/app.html"
    },
    {
      "source": "/scanner",
      "destination": "/app.html"
    },
    {
      "source": "/scanner/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/seller",
      "destination": "/app.html"
    },
    {
      "source": "/seller/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/pr",
      "destination": "/app.html"
    },
    {
      "source": "/pr/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/shadowbyash",
      "destination": "/app.html"
    },
    {
      "source": "/shadowbyash/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/shadow",
      "destination": "/app.html"
    },
    {
      "source": "/shadow/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/view/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/tickets",
      "destination": "/app.html"
    },
    {
      "source": "/tickets/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/events",
      "destination": "/app.html"
    },
    {
      "source": "/events/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
