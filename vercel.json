{
  "version": 2,
  "crons": [
    { "path": "/api/cron/vibora-proactive", "schedule": "0 10 * * *" }
  ],
  "buildCommand": "cd staging/combined-app && npm install && npm run vercel-build",
  "outputDirectory": "staging/combined-app/dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "organiser.littx.in"
        }
      ],
      "destination": "/organizer",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.littx.in" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pr.littx.in" }],
      "destination": "/pr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/organizer",
      "destination": "/app.html"
    },
    {
      "source": "/organizer/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/bookings",
      "destination": "/app.html"
    },
    {
      "source": "/accept-invitation",
      "destination": "/app.html"
    },
    {
      "source": "/bookings/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/solverbydevashtu",
      "destination": "/app.html"
    },
    {
      "source": "/scanner",
      "destination": "/app.html"
    },
    {
      "source": "/scanner/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/seller",
      "destination": "/app.html"
    },
    {
      "source": "/seller/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/pr",
      "destination": "/app.html"
    },
    {
      "source": "/pr/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/shadowbyash",
      "destination": "/app.html"
    },
    {
      "source": "/shadowbyash/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/shadow",
      "destination": "/app.html"
    },
    {
      "source": "/shadow/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/view/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/tickets",
      "destination": "/app.html"
    },
    {
      "source": "/tickets/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/events",
      "destination": "/app.html"
    },
    {
      "source": "/events/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/vibora",
      "destination": "/vibora-littx.html"
    },
    {
      "source": "/app",
      "destination": "/vibora-littx.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
