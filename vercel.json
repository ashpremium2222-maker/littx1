{
  "version": 2,
  "buildCommand": "cd staging/combined-app && npm install && npm run build",
  "outputDirectory": "staging/combined-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/littx/(.*)",
      "destination": "/littx/$1"
    },
    {
      "source": "/",
      "destination": "/littx/index.html"
    },
    {
      "source": "/(dashboard|dashhboard|admin|master-admin|company|seller|pr|tickets|scanner|login|admin-login|customer)(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/littx/index.html"
    }
  ]
}

