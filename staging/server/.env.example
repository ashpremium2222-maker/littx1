# ============================
# LITTX — Environment Variables
# ============================
# Copy this file to .env and fill in the values before running the server.

# Server Settings
PORT=3000
BASE_URL=http://localhost:3000
# Comma-separated trusted web origins. Set explicit production frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PAYMENT_TEST_MODE=true
ADMIN_KEY=
PRESENTATION_KEY=
PORTAL_ADMIN_KEY=
PORTAL_DASHBOARD_KEY=
MASTER_PASS=
COMPANY_ADMIN_PASS=

# Master ticket generator reveal password (server only; configure in deployment secrets)
SOLVER_REVEAL_PASSWORD=replace-with-a-strong-secret

# Gate scanner login. Use a unique password (12+ characters) and an unrelated
# random session-signing secret (32+ characters). Never place either in the app.
SCANNER_PASSWORD=replace-with-a-strong-unique-password
SCANNER_SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated event names and owning companyId assigned to this shared scanner login.
SCANNER_EVENT_NAMES=DHOLIDA GARBA ROYALE
SCANNER_COMPANY_ID=littlane

# Seller WebAuthn / passkeys. Required outside local development.
# Use the public HTTPS origin where the seller portal is hosted; no trailing slash.
WEBAUTHN_ORIGIN=https://your-domain.example
# Optional when the relying-party ID differs from the origin hostname.
WEBAUTHN_RP_ID=your-domain.example

# Database
# Provide your MongoDB connection string here (e.g., MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/littx

# Seller Accounts Passwords (set unique values in deployment secrets)
SELLER_A_PASS=
SELLER_B_PASS=
SELLER_C_PASS=
SELLER_LITTLANE_PASS=replace-with-a-strong-secret
SELLER_NITRO_PASS=replace-with-a-strong-secret
SELLER_7TH_HEAVEN_PASS=replace-with-a-strong-secret

# Private Shadow Panel password
SHADOW_PASS=replace-with-a-strong-secret
SHADOW_PRIVATE_PASS=replace-with-a-strong-secret

# PR Partner Passwords (set unique values in deployment secrets)
PR1_PASS=
PR2_PASS=
PR3_PASS=
PR4_PASS=
PR5_PASS=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Settings (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=

# WhatsApp Provider (Option A: RichAutomate - recommended)
RICHAUTOMATE_API_KEY=ra_live_your_key_here
RICHAUTOMATE_TEMPLATE_NAME=ticket_confirmation_dgr
RICHAUTOMATE_TEMPLATE_LANG=en
# RICHAUTOMATE_ATTACH_PDF=true # optional: attach ticket PDF as header media

# WhatsApp Provider (Option B: Direct Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=ticket_confirmation_dgr
WHATSAPP_TEMPLATE_LANG=en
