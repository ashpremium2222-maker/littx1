# ============================
# LITTX — Environment Variables
# ============================
# Copy this file to .env and fill in the values before running the server.

# Server Settings
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_KEY=change-me-admin-key

# Seller WebAuthn / passkeys. Required outside local development.
# Use the public HTTPS origin where the seller portal is hosted; no trailing slash.
WEBAUTHN_ORIGIN=https://your-domain.example
# Optional when the relying-party ID differs from the origin hostname.
WEBAUTHN_RP_ID=your-domain.example

# Database
# Provide your MongoDB connection string here (e.g., MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/littx

# Seller Accounts Passwords (Optional - defaults provided in code)
SELLER_A_PASS=littx-a-2026
SELLER_B_PASS=littx-b-2026
SELLER_C_PASS=littx-c-2026
SELLER_LITTLANE_PASS=replace-with-a-strong-secret
SELLER_NITRO_PASS=replace-with-a-strong-secret
SELLER_7TH_HEAVEN_PASS=replace-with-a-strong-secret

# Private Shadow Panel password
SHADOW_PASS=replace-with-a-strong-secret

# PR Partner Passwords (Optional - defaults provided in code)
PR1_PASS=ftpr@001
PR2_PASS=ftpr@002
PR3_PASS=ftpr@003
PR4_PASS=ftpr@004
PR5_PASS=ftpr@005

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Settings (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=

# WhatsApp Provider (Option A: RichAutomate - recommended)
RICHAUTOMATE_API_KEY=ra_live_your_key_here
RICHAUTOMATE_TEMPLATE_NAME=ticket_confirmation_dgr
RICHAUTOMATE_TEMPLATE_LANG=en
# RICHAUTOMATE_ATTACH_PDF=true # optional: attach ticket PDF as header media

# WhatsApp Provider (Option B: Direct Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=littx_meta_verify_2026
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=ticket_confirmation_dgr
WHATSAPP_TEMPLATE_LANG=en
