# ============================
# LITTX — Environment Variables
# ============================
# Copy this file to .env and fill in the values before running the server.

# Server Settings
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_KEY=change-me-admin-key

# Database
# Provide your MongoDB connection string here (e.g., MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/littx

# Seller Accounts Passwords (Optional - defaults provided in code)
SELLER_A_PASS=littx-a-2026
SELLER_B_PASS=littx-b-2026
SELLER_C_PASS=littx-c-2026

# PR Partner Passwords (Optional - defaults provided in code)
PR1_PASS=ftpr@001
PR2_PASS=ftpr@002
PR3_PASS=ftpr@003
PR4_PASS=ftpr@004
PR5_PASS=ftpr@005

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Settings (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=
